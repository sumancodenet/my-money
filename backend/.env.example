PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moneyflow
DB_USER=root
DB_PASSWORD=
JWT_SECRET=change_this_to_a_long_random_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Fingerprint / Passkey (WebAuthn) — env ki zaroorat NAHI hai.
# Code request ke domain se khud RP_ID/ORIGIN bana leta hai:
# localhost dev -> localhost / http://localhost:5173
# Vercel (frontend+backend same project/domain) -> usi domain ka rpId/origin
# RP_ID/ORIGIN sirf tab set karo jab frontend aur backend alag domains par hon.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@moneyflow.app
